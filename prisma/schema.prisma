// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Auth Models (NextAuth) ──────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("user") // "user" | "admin"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  diaries               Diary[]
  progress              UserProgress?
  wardrobeItems         UserWardrobeItem[]
  keigoProgress         KeigoLessonProgress[]
  learningDiaryProgress LearningDiaryProgress[]
  likes         Like[]
  comments      Comment[]
  blocking      UserBlock[] @relation("BlockerRelation")
  blockedBy     UserBlock[] @relation("BlockedRelation")
  reports       Report[]
  vocabReviews          VocabReview[]
  dailyChallenges       DailyChallenge[]
  challengerBattles     RoastBattle[] @relation("ChallengerBattles")
  userAchievements      UserAchievement[]
}

// ── Diary ─────────────────────────────────────────────────────────────────────

model Diary {
  id        String   @id @default(cuid())
  title     String
  content   String
  mood      String?
  topicId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPublic       Boolean   @default(false)
  isTutorPublic  Boolean   @default(false)
  tutorReview    String?
  likes          Like[]
  comments       Comment[]

  @@index([userId, createdAt])
  @@index([isPublic, createdAt])
}

// ── Gamification ──────────────────────────────────────────────────────────────

model UserProgress {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp              Int       @default(0)
  level           Int       @default(1)
  totalStamps     Int       @default(0)
  streakDays      Int       @default(0)
  activeCharacter String    @default("shiba") // "shiba" | "poodle" | "beagle" | "pomeranian"
  lastStudyAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model WardrobeItem {
  id            String             @id @default(cuid())
  name          String
  description   String?
  imageUrl      String
  icon          String
  isRare        Boolean            @default(false)
  requiredLevel Int                @default(1)
  stampCost     Int                @default(0)
  ownerships    UserWardrobeItem[]
  createdAt     DateTime           @default(now())
}

model UserWardrobeItem {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  wardrobeItemId String
  wardrobeItem   WardrobeItem @relation(fields: [wardrobeItemId], references: [id])
  equippedAt     DateTime?
  earnedAt       DateTime     @default(now())

  @@unique([userId, wardrobeItemId])
}

model DailyChallenge {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String    // "DIARY", "LESSON", "REVIEW", "QUIZ"
  difficulty    String    @default("MEDIUM") // "EASY" | "MEDIUM" | "HARD"
  requirement   Int       // e.g., 1 diary, 2 lessons, 10 reviews
  rewardStamps  Int       @default(1)
  xpReward      Int       @default(0)
  completed     Boolean   @default(false)
  claimedAt     DateTime?
  progress      Int       @default(0) // current progress toward requirement
  createdAt     DateTime  @default(now())
  expiresAt     DateTime  // end of day in user's timezone

  @@index([userId, expiresAt])
  @@index([userId, completed, expiresAt])
}

// ── Keigo Lesson Progress ─────────────────────────────────────────────────────

model KeigoLessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  completed   Boolean   @default(false)
  quizScore   Int?
  quizTotal   Int?
  completedAt DateTime?
  xpAwarded   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId, completed])
}

// ── Learning Diary Progress ───────────────────────────────────────────────────

model LearningDiaryProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  diaryId     String
  quizScore   Int?
  quizTotal   Int?
  completedAt DateTime @default(now())
  xpAwarded   Int      @default(0)

  @@unique([userId, diaryId])
}

// ── Content Models ────────────────────────────────────────────────────────────

model Topic {
  id           String   @id @default(cuid())
  title        String
  titleJp      String
  category     String
  difficulty   Int      @default(1)
  wordCount    Int      @default(0)
  grammarCount Int      @default(0)
  imageUrl     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Learning Content Models ───────────────────────────────────────────────────

model KeigoLesson {
  id            String   @id
  title         String
  category      String
  thumbnail     String
  dialogue      String   // JSON: DialogueLine[]
  grammarPoints String   // JSON: GrammarPoint[]
  vocab         String   // JSON: VocabItem[] (word, reading, meaning)
  quiz          String   // JSON: QuizItem[]
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model LearningDiaryEntry {
  id            String   @id
  title         String
  titleKo       String
  category      String
  level         String
  thumbnail     String
  contentJp     String   // JSON: RubySegment[]
  contentKo     String
  vocabulary    String   // JSON: VocabEntry[]
  grammarPoints String   // JSON: GrammarPoint[]
  quiz          String   // JSON: QuizItem[]
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ── Community Models ──────────────────────────────────────────────────────────

model Like {
  id        String   @id @default(cuid())
  userId    String
  diaryId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  diary     Diary    @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@unique([userId, diaryId])
  @@index([diaryId])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  diaryId   String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  diary     Diary    @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@index([diaryId])
  @@index([userId])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedRelation", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([resolved, targetType])
}

// ── Roast Battle ────────────────────────────────────────────────────────────

model RoastBattle {
  id             String    @id @default(cuid())
  challengerId   String
  defenderId     String?
  scenarioId     String
  challengerText String?
  defenderText   String?
  challengerScore Int?
  defenderScore   Int?
  status         String    @default("PENDING")  // PENDING | ACTIVE | JUDGED | EXPIRED
  winnerId       String?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  challenger     User      @relation("ChallengerBattles", fields: [challengerId], references: [id], onDelete: Cascade)
  scenario       RoastScenario @relation(fields: [scenarioId], references: [id])

  @@index([challengerId, status])
  @@index([expiresAt])
}

model RoastScenario {
  id          String   @id @default(cuid())
  title       String
  description String   // Korean scenario description
  contextJp   String   // Japanese context text
  difficulty  String   @default("NORMAL")  // EASY | NORMAL | HARD
  category    String   // "sonkeigo" | "kenjougo" | "teineigo"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  battles     RoastBattle[]
}

// ── Vocab Review (SRS) ───────────────────────────────────────────────────────

model VocabReview {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word         String
  reading      String   @default("")
  meaning      String
  source       String
  itemType     String   @default("vocab") // "vocab" | "grammar"
  context      String?  // JSON string for grammar context
  tier         Int      @default(0)
  nextReviewAt DateTime @default(now())
  reviewCount  Int      @default(0)
  isBookmarked Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, word, itemType])
  @@index([userId, nextReviewAt])
  @@index([userId, itemType])
  @@index([userId, isBookmarked])
}

// ── Achievements ──────────────────────────────────────────────────────────────

model Achievement {
  id            String   @id @default(cuid())
  key           String   @unique
  nameKo        String
  nameEn        String
  descriptionKo String
  icon          String   // emoji
  category      String   // "learning" | "streak" | "social" | "quest" | "mastery"
  tier          String   @default("bronze")  // bronze | silver | gold
  threshold     Int      @default(1)
  createdAt     DateTime @default(now())
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
}
